use aimer::input::button::Button;
use aimer::input::callback::VoidCallback;
use aimer::style::*;
use aimer::*;

// this is the entry point of the app
#[aimer::main]
fn main() {
    // simply start the app with AimerApp::start
    AimerApp::start(CounterWidget::new(2))
}

#[derive(StatefulWidget)]
pub struct CounterWidget {
    pub initial_count: i32,
}

impl CounterWidget {
    pub fn new(initial_count: i32) -> Self {
        Self { initial_count }
    }
}
// create a state for the CounterWidget
pub struct CounterState {
    count: i32,
    updater: StateUpdater<Self>,
}

// implement the StatefulWidget trait for CounterWidget
impl StatefulWidget for CounterWidget {
    type State = CounterState;

    fn create_state(self) -> CounterState {
        CounterState {
            count: self.initial_count,
            updater: StateUpdater::empty(),
        }
    }
}
// implement the State trait for CounterState
impl State<CounterWidget> for CounterState {
    fn init_state(&mut self, _updater: StateUpdater<Self>)
    where
        Self: Sized,
    {
        self.updater = _updater
    }

    // build the widget with state
    fn build(&self, _: &BuildContext) -> impl Widget {
        let updater = self.updater.clone();
        Container::new()
            .color(Color::WHITE)
            .padding(LayoutSpacing::new().top(20))
            .child(
                Column::new()
                    .vertical_alignment(BoxAlignment::Center)
                    .horizontal_alignment(BoxAlignment::Center)
                    .children([
                        Text::new("Widget with State")
                            .text_style(
                                TextStyle::new()
                                    .font_size(30)
                                    .color(Colors::Black)
                                    .font_weight(FontWeight::Bold),
                            )
                            .boxed(),
                        SizedBox::new().height(50).boxed(),
                        Text::new(format!("Clicked: {}", self.count,))
                            .text_style(TextStyle::new().font_size(25).color(Colors::Black))
                            .boxed(),
                        SizedBox::new().height(50).boxed(),
                        my_button("Increase", move || {
                            updater.set_state(|state| {
                                state.count += 1;
                            });
                        }),
                         SizedBox::new().height(20).boxed(),
                        my_button("Decrease", move || {
                            updater.set_state(|state| {
                                state.count -= 1;
                            });
                        }),
                       
                    ]),
            )
    }
}

// functional style widget
fn my_button(label: &str, on_click: impl Into<VoidCallback>) -> AnyWidget {
    Container::new()
        .box_decoration(BoxDecoration::new().border_radius(8))
        .width(200)
        .height(50)
        .box_child(
            Button::new()
                .on_press(on_click)
                .decoration(BoxDecoration::new().background_color(Color::BLACK))
                .child(
                    Text::new(label.to_string())
                        .text_align(TextAlign::MidCenter)
                        .text_style(TextStyle::new().color(Color::WHITE)),
                ),
        )
}
